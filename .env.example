# Copy to .env.local and fill in before launch.

# Canonical origin used for metadata, Open Graph, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Clinic phone number, international format, digits only (e.g. 20XXXXXXXXXX).
# While empty, the site shows "+20 1XX XXX XXXX" and non-working placeholder links.
NEXT_PUBLIC_PHONE_NUMBER=

# WhatsApp number, same format. Defaults to the phone number when empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-only. HTTPS endpoint that receives contact-form submissions as a JSON
# POST: { name, phone, email, subject, message, source, submittedAt }.
# While empty, the form offers to send the message via WhatsApp instead.
CONTACT_FORM_ENDPOINT=
