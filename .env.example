# Copy to .env.local (local development) or set in Vercel → Project → Settings →
# Environment Variables. Never commit real values. Only names are listed here.

# Canonical origin used for metadata, Open Graph, sitemap, structured data and
# the links in password-reset emails (e.g. https://www.your-domain.com).
NEXT_PUBLIC_SITE_URL=

# --- CMS (Supabase) ------------------------------------------------------------
# Project URL and the PUBLISHABLE key (Supabase → Project Settings → API Keys).
# Both are public by design: Row Level Security decides what they can do.
# While either is empty, the website shows the content bundled in data/ and the
# dashboard at /admin shows setup instructions.
# The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
# Do NOT put the secret / service-role key here or anywhere in this project:
# neither the website, the dashboard nor the scripts need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Contact form ------------------------------------------------------------------
# Server-only, optional. HTTPS endpoint that also receives contact-form
# submissions as a JSON POST: { name, phone, email, subject, message, source,
# submittedAt }. With the CMS connected, messages are saved in the dashboard
# inbox (Global settings → "Save contact-form messages"); either delivery is
# enough. With neither, the form offers to send the message via WhatsApp.
CONTACT_FORM_ENDPOINT=

# --- Without the CMS only ----------------------------------------------------------
# Used only while Supabase is not configured (bundled content). Once the CMS is
# connected, the phone and WhatsApp numbers are edited in Global settings.
# Digits only, international format (e.g. 20XXXXXXXXXX). Empty = placeholder.
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=
